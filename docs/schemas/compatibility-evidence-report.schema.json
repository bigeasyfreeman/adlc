{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/compatibility-evidence-report.schema.json",
  "title": "ADLC Compatibility Evidence Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["contract_version", "status", "tasks", "issues"],
  "properties": {
    "contract_version": {"type": "string"},
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "tasks": {"type": "array", "items": {"type": "object"}},
    "issues": {"type": "array", "items": {"type": "object"}}
  }
}
