{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/operator-comprehension-quiz.schema.json",
  "title": "ADLC Operator Comprehension Quiz",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "brief_id", "status", "blast_radius", "questions"],
  "properties": {
    "contract_version": {"type": "string"},
    "brief_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string"},
    "status": {"type": "string", "enum": ["passed", "failed", "delegated", "not_applicable"]},
    "blast_radius": {"type": "string", "enum": ["low", "medium", "high"]},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "question", "operator_answer", "evaluation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "enum": ["behavior_change", "blast_radius", "failure_modes"]},
          "question": {"type": "string", "minLength": 1},
          "operator_answer": {"type": "string"},
          "evaluation": {"type": "string", "enum": ["pass", "fail"]}
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegated_to", "reason", "recorded_at"],
      "properties": {
        "delegated_to": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "remediation_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path", "missed_categories"],
      "properties": {
        "artifact_type": {"type": "string", "enum": ["explainer"]},
        "path": {"type": "string", "minLength": 1},
        "missed_categories": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["behavior_change", "blast_radius", "failure_modes"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "properties": {"questions": {"minItems": 3}},
        "not": {"required": ["delegation"]}
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "required": ["remediation_artifact"],
        "properties": {"questions": {"minItems": 3}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "delegated"}}},
      "then": {
        "required": ["delegation"]
      }
    },
    {
      "if": {"properties": {"status": {"const": "not_applicable"}}},
      "then": {
        "properties": {
          "blast_radius": {"const": "low"},
          "questions": {"maxItems": 0}
        }
      }
    }
  ]
}
