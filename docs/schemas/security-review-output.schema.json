{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/security-review-output.schema.json",
  "title": "ADLC Security Review Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "assessment"],
  "properties": {
    "label": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains_evaluated", "findings", "critical_count", "high_count", "summary"],
      "properties": {
        "domains_evaluated": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["appsec", "llm", "agentic", "api", "infra"]}
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity", "description", "mitigation"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "severity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
              "description": {"type": "string", "minLength": 1},
              "mitigation": {"type": "string", "minLength": 1},
              "file": {"type": "string"},
              "line": {"type": "integer", "minimum": 1}
            }
          }
        },
        "critical_count": {"type": "integer", "minimum": 0},
        "high_count": {"type": "integer", "minimum": 0},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
