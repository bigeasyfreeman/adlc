{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/public-operation-result.schema.json",
  "title": "ADLC Public Operation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "operation", "status", "stop_reason", "evidence_refs",
    "approval_requirements", "compatibility_warnings", "compatibility", "kernel", "result",
    "no_overclaim", "limitations"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "operation": {
      "type": "string",
      "enum": ["init", "shape", "build", "fix", "review", "harden", "ship", "status", "resume", "doctor", "learn"]
    },
    "request_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["completed", "planned", "blocked", "awaiting_human", "failed"]},
    "stop_reason": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "approval_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "compatibility_warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "public_command", "low_level_commands"],
      "properties": {
        "support": {"const": "experimental"},
        "public_command": {"const": "public-operation"},
        "low_level_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "deprecated", "replacement", "retained_through"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "deprecated": {"const": false},
              "replacement": {"const": "public-operation"},
              "retained_through": {"const": "0.x"}
            }
          }
        }
      }
    },
    "kernel": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result": {"type": "object", "additionalProperties": true},
    "no_overclaim": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["planned", "blocked", "awaiting_human", "failed"]}}},
      "then": {"properties": {"stop_reason": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "awaiting_human"}}},
      "then": {"properties": {"approval_requirements": {"minItems": 1}}}
    }
  ]
}
