{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/pending-questions.schema.json",
  "title": "ADLC Pending Questions",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "status", "questions"],
  "properties": {
    "contract_version": {"type": "string"},
    "status": {"type": "string", "enum": ["blocked", "empty"]},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ledger_entry_id", "question", "architecture_impact", "why_it_matters", "what_changes", "conservative_default"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "ledger_entry_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "architecture_impact": {"type": "string", "enum": ["high", "medium", "low"]},
          "why_it_matters": {"type": "string", "minLength": 1},
          "what_changes": {"type": "string", "minLength": 1},
          "conservative_default": {"type": "string", "minLength": 1},
          "source": {"type": "string", "enum": ["authored", "generated"]},
          "machine_generated": {"type": "boolean"}
        }
      }
    }
  }
}
