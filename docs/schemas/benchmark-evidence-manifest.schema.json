{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/benchmark-evidence-manifest.schema.json",
  "title": "ADLC Benchmark Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "algorithm", "files", "aggregate_sha256"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "algorithm": {"const": "sha256"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "aggregate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
