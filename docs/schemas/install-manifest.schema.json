{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.dev/schemas/install-manifest.schema.json",
  "title": "ADLC Install Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_version",
    "provider",
    "target_paths",
    "digests",
    "bundle_digest",
    "ownership",
    "rollback_ref",
    "linked",
    "hooks_enabled",
    "hook_paths",
    "hook_digests",
    "hook_consent_ref",
    "no_overclaim",
    "limitations"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "source_version": {"type": "string", "minLength": 1},
    "provider": {"enum": ["claude", "codex"]},
    "target_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "digests": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "bundle_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ownership": {"const": "adlc-managed"},
    "rollback_ref": {"type": ["string", "null"]},
    "linked": {"type": "boolean"},
    "hooks_enabled": {"type": "boolean"},
    "hook_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "hook_digests": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "hook_consent_ref": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "no_overclaim": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
