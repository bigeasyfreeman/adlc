{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/teach-packet.schema.json",
  "title": "ADLC Teach-First Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "dimension", "key_concepts", "criteria", "contrast_pair", "ratification"],
  "properties": {
    "contract_version": {"type": "string"},
    "dimension": {"type": "string", "minLength": 1},
    "key_concepts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "criteria": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "contrast_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["medium", "good_ref", "bad_ref", "why_good", "why_bad"],
      "properties": {
        "medium": {"type": "string", "enum": ["visual", "ux_flow", "prose", "report", "content", "code", "other"]},
        "good_ref": {"type": "string", "minLength": 1},
        "bad_ref": {"type": "string", "minLength": 1},
        "why_good": {"type": "string", "minLength": 1},
        "why_bad": {"type": "string", "minLength": 1}
      }
    },
    "ratification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratified_by", "ratified_at"],
      "properties": {
        "ratified_by": {"type": "string", "minLength": 1},
        "ratified_at": {"type": "string", "format": "date-time"},
        "edits": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
