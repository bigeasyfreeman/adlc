{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/completion-audit-independence.schema.json",
  "title": "ADLC Completion Audit Independence Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "basis", "executor", "auditor", "evidence_refs"],
  "properties": {
    "contract_version": {"type": "string", "const": "1.0.0"},
    "basis": {"type": "string", "enum": ["separate_agent", "separate_session", "external_reviewer"]},
    "executor": {"$ref": "#/definitions/actor"},
    "auditor": {"$ref": "#/definitions/actor"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "definitions": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "session_id"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
