{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/epistemic-ledger.schema.json",
  "title": "ADLC Epistemic Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "entries"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/entry"}
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "claim", "architecture_affecting", "sources"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["KNOWN", "ASSUMED", "UNKNOWN"]},
        "claim": {"type": "string", "minLength": 1},
        "architecture_affecting": {"type": "boolean"},
        "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "resolution": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "enum": ["repo-evidence", "human-answer", "accepted-risk", "ask-user", "deferred"]},
        "human_answer_ref": {"type": "string", "minLength": 1},
        "accepted_risk_ref": {"type": "string", "minLength": 1},
        "related_blindspot_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "contract_surface_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["KNOWN", "ASSUMED"]}}},
          "then": {"properties": {"sources": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "UNKNOWN"}, "disposition": {"const": "human-answer"}}},
          "then": {"required": ["human_answer_ref"]}
        },
        {
          "if": {"properties": {"status": {"const": "UNKNOWN"}, "disposition": {"const": "accepted-risk"}}},
          "then": {"required": ["accepted_risk_ref"]}
        }
      ]
    }
  }
}
