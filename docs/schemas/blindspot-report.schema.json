{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bigeasyfreeman/adlc/blob/main/docs/schemas/blindspot-report.schema.json",
  "title": "ADLC Blindspot Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "items"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "finding", "ledger_entry_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {
            "type": "string",
            "enum": ["prior_art", "removal_or_pothole", "conventions_doc", "domain_vocabulary", "adjacent_system", "contract_surface"]
          },
          "finding": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "ledger_entry_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
