diff --git a/src/invoice.py b/src/invoice.py
index ac83153..b341f78 100644
--- a/src/invoice.py
+++ b/src/invoice.py
@@ -3 +3 @@ from __future__ import annotations
-from decimal import Decimal, ROUND_HALF_UP
+from decimal import Decimal, ROUND_DOWN
@@ -10 +10 @@ def allocate_discount(line_totals: list[Decimal], discount: Decimal) -> list[Dec
-    """Allocate an invoice discount proportionally at cent precision."""
+    """Allocate an invoice discount proportionally and reconcile every cent."""
@@ -18 +18,8 @@ def allocate_discount(line_totals: list[Decimal], discount: Decimal) -> list[Dec
-    return [(discount * line / total).quantize(CENT, rounding=ROUND_HALF_UP) for line in line_totals]
+
+    exact = [discount * line / total for line in line_totals]
+    allocated = [amount.quantize(CENT, rounding=ROUND_DOWN) for amount in exact]
+    remainder_cents = int((discount - sum(allocated, Decimal("0"))) / CENT)
+    priority = sorted(range(len(exact)), key=lambda index: (exact[index] - allocated[index], -index), reverse=True)
+    for index in priority[:remainder_cents]:
+        allocated[index] += CENT
+    return allocated
